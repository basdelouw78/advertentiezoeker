<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="AdvertentieZoeker.App.Views.SearchEditPage"
             Title="Zoekopdracht"
             BackgroundColor="{StaticResource Background}">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="14">

            <Label Text="Naam" FontAttributes="Bold" />
            <Entry x:Name="NameEntry" Placeholder="Bijv. Racefiets Amsterdam" />

            <Label Text="Steekwoorden" FontAttributes="Bold" />
            <Entry x:Name="KeywordsEntry" Placeholder="Bijv. racefiets carbon" />
            <Label Text="Zoals je ze ook in de Marktplaats-zoekbalk zou typen." FontSize="12" TextColor="Gray" />

            <Label Text="Staat" FontAttributes="Bold" Margin="0,10,0,0" />
            <Label Text="Laat niets aangevinkt om alle staten mee te nemen." FontSize="12" TextColor="Gray" />
            <VerticalStackLayout Spacing="4">
                <HorizontalStackLayout Spacing="8">
                    <CheckBox x:Name="NieuwCheckBox" />
                    <Label Text="Nieuw" VerticalOptions="Center" />
                </HorizontalStackLayout>
                <HorizontalStackLayout Spacing="8">
                    <CheckBox x:Name="ZoGoedAlsNieuwCheckBox" />
                    <Label Text="Zo goed als nieuw" VerticalOptions="Center" />
                </HorizontalStackLayout>
                <HorizontalStackLayout Spacing="8">
                    <CheckBox x:Name="GebruiktCheckBox" />
                    <Label Text="Gebruikt" VerticalOptions="Center" />
                </HorizontalStackLayout>
                <HorizontalStackLayout Spacing="8">
                    <CheckBox x:Name="RefurbishedCheckBox" />
                    <Label Text="Refurbished" VerticalOptions="Center" />
                </HorizontalStackLayout>
                <HorizontalStackLayout Spacing="8">
                    <CheckBox x:Name="NietWerkendCheckBox" />
                    <Label Text="Niet werkend" VerticalOptions="Center" />
                </HorizontalStackLayout>
            </VerticalStackLayout>

            <Label Text="Postcode" FontAttributes="Bold" Margin="0,10,0,0" />
            <Entry x:Name="ZipCodeEntry" Placeholder="Bijv. 1012AB" MaxLength="6" />

            <Label Text="Maximale afstand (km)" FontAttributes="Bold" />
            <Entry x:Name="DistanceEntry" Placeholder="Bijv. 25 (leeg = heel Nederland)" Keyboard="Numeric" />

            <HorizontalStackLayout Spacing="8" Margin="0,10,0,0">
                <Switch x:Name="EnabledSwitch" IsToggled="True" />
                <Label Text="Actief" VerticalOptions="Center" FontAttributes="Bold" />
            </HorizontalStackLayout>

            <Button Text="Opslaan" Clicked="OnSaveClicked" Margin="0,20,0,0" />
            <Button x:Name="DeleteButton" Text="Verwijderen" BackgroundColor="{StaticResource Danger}"
                    Clicked="OnDeleteClicked" IsVisible="False" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
