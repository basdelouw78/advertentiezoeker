<?xml version="1.0" encoding="UTF-8" ?>
<Shell xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
       xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
       xmlns:views="clr-namespace:AdvertentieZoeker.App.Views"
       x:Class="AdvertentieZoeker.App.AppShell"
       Title="Advertentiezoeker">

    <TabBar>
        <ShellContent Title="Zoekopdrachten"
                      ContentTemplate="{DataTemplate views:SearchesPage}"
                      Route="zoekopdrachten" />
        <ShellContent Title="Gevonden"
                      ContentTemplate="{DataTemplate views:ResultsPage}"
                      Route="gevonden" />
        <ShellContent Title="Instellingen"
                      ContentTemplate="{DataTemplate views:SettingsPage}"
                      Route="instellingen" />
    </TabBar>

</Shell>
