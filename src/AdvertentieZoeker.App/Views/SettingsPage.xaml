<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="AdvertentieZoeker.App.Views.SettingsPage"
             Title="Instellingen"
             BackgroundColor="{StaticResource Background}">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="14">

            <Label Text="Controle-interval (minuten)" FontAttributes="Bold" />
            <Entry x:Name="PollIntervalEntry" Keyboard="Numeric" Placeholder="30" />
            <Label Text="Minimaal 5 minuten. Standaard elke 30 minuten." FontSize="12" TextColor="Gray" />

            <HorizontalStackLayout Spacing="8" Margin="0,10,0,0">
                <Switch x:Name="PopupSwitch" />
                <Label Text="Pop-upmelding op dit toestel" VerticalOptions="Center" FontAttributes="Bold" />
            </HorizontalStackLayout>

            <BoxView HeightRequest="1" Color="LightGray" Margin="0,16" />

            <HorizontalStackLayout Spacing="8">
                <Switch x:Name="EmailEnabledSwitch" />
                <Label Text="E-mailmelding versturen" VerticalOptions="Center" FontAttributes="Bold" />
            </HorizontalStackLayout>

            <Label Text="SMTP-server" />
            <Entry x:Name="SmtpHostEntry" Placeholder="Bijv. smtp.gmail.com" />

            <Label Text="SMTP-poort" />
            <Entry x:Name="SmtpPortEntry" Keyboard="Numeric" Placeholder="587" />

            <HorizontalStackLayout Spacing="8">
                <Switch x:Name="SmtpSslSwitch" IsToggled="True" />
                <Label Text="Beveiligde verbinding (STARTTLS)" VerticalOptions="Center" />
            </HorizontalStackLayout>

            <Label Text="Gebruikersnaam" />
            <Entry x:Name="SmtpUsernameEntry" Placeholder="Meestal je e-mailadres" />

            <Label Text="Wachtwoord (app-wachtwoord aanbevolen)" />
            <Entry x:Name="SmtpPasswordEntry" IsPassword="True" />

            <Label Text="Afzender" />
            <Entry x:Name="FromAddressEntry" Placeholder="jij@voorbeeld.nl" Keyboard="Email" />

            <Label Text="Ontvanger" />
            <Entry x:Name="ToAddressEntry" Placeholder="jij@voorbeeld.nl" Keyboard="Email" />

            <Button Text="Opslaan" Clicked="OnSaveClicked" Margin="0,20,0,0" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
