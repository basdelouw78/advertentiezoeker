<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:services="clr-namespace:AdvertentieZoeker.App.Services"
             x:Class="AdvertentieZoeker.App.Views.ResultsPage"
             Title="Gevonden advertenties"
             BackgroundColor="{StaticResource Background}">

    <RefreshView x:Name="RefreshViewControl" Refreshing="OnRefreshing">
        <CollectionView x:Name="EntriesCollectionView">
            <CollectionView.EmptyView>
                <VerticalStackLayout Padding="24" VerticalOptions="Center">
                    <Label Text="Nog geen advertenties gevonden." HorizontalOptions="Center" TextColor="Gray" />
                </VerticalStackLayout>
            </CollectionView.EmptyView>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="services:FoundListingEntry">
                    <Grid Padding="16,12" ColumnDefinitions="72,*" ColumnSpacing="12" RowDefinitions="Auto,Auto,Auto,Auto">
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnItemTapped" />
                        </Grid.GestureRecognizers>
                        <Border Grid.Column="0" Grid.Row="0" Grid.RowSpan="4" WidthRequest="72" HeightRequest="72"
                                StrokeShape="RoundRectangle 8" Stroke="LightGray" StrokeThickness="1"
                                VerticalOptions="Start" Padding="0" BackgroundColor="#EDF2EE">
                            <Image Source="{Binding Listing.ImageUrl}" Aspect="AspectFill" WidthRequest="72" HeightRequest="72" />
                        </Border>
                        <Label Grid.Column="1" Grid.Row="0" Text="{Binding Listing.Title}" FontAttributes="Bold" />
                        <Label Grid.Column="1" Grid.Row="1" Text="{Binding Listing.PriceInEuros, StringFormat='€ {0:0.00}'}"
                               FontAttributes="Bold" TextColor="{StaticResource Primary}" />
                        <Label Grid.Column="1" Grid.Row="2" Text="{Binding SearchName, StringFormat='Zoekopdracht: {0}'}" FontSize="12" TextColor="Gray" />
                        <Label Grid.Column="1" Grid.Row="3" Text="{Binding FoundAt, StringFormat='Gevonden op {0:dd-MM-yyyy HH:mm}'}" FontSize="12" TextColor="Gray" />
                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </RefreshView>
</ContentPage>
