<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:services="clr-namespace:AdvertentieZoeker.App.Services"
             x:Class="AdvertentieZoeker.App.Views.ResultsPage"
             Title="Gevonden advertenties"
             BackgroundColor="{StaticResource Background}">

    <RefreshView x:Name="RefreshViewControl" Refreshing="OnRefreshing">
        <CollectionView x:Name="EntriesCollectionView">
            <CollectionView.EmptyView>
                <VerticalStackLayout Padding="24" VerticalOptions="Center">
                    <Label Text="Nog geen advertenties gevonden." HorizontalOptions="Center" TextColor="Gray" />
                </VerticalStackLayout>
            </CollectionView.EmptyView>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="services:FoundListingEntry">
                    <Grid Padding="16,12" ColumnDefinitions="*" RowDefinitions="Auto,Auto,Auto">
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnItemTapped" />
                        </Grid.GestureRecognizers>
                        <Label Grid.Row="0" Text="{Binding Listing.Title}" FontAttributes="Bold" />
                        <Label Grid.Row="1" Text="{Binding SearchName, StringFormat='Zoekopdracht: {0}'}" FontSize="12" TextColor="Gray" />
                        <Label Grid.Row="2" Text="{Binding FoundAt, StringFormat='Gevonden op {0:dd-MM-yyyy HH:mm}'}" FontSize="12" TextColor="Gray" />
                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </RefreshView>
</ContentPage>
