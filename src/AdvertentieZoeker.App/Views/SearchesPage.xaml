<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:AdvertentieZoeker.Core.Models;assembly=AdvertentieZoeker.Core"
             x:Class="AdvertentieZoeker.App.Views.SearchesPage"
             Title="Zoekopdrachten"
             BackgroundColor="{StaticResource Background}">

    <ContentPage.ToolbarItems>
        <ToolbarItem Text="+ Nieuw" Clicked="OnAddClicked" />
    </ContentPage.ToolbarItems>

    <Grid RowDefinitions="Auto,*">
        <Grid Grid.Row="0" Padding="16,10" ColumnDefinitions="*,Auto" ColumnSpacing="10" BackgroundColor="#EDF2EE">
            <Label Grid.Column="0" x:Name="StatusLabel" Text="Nog niet gecontroleerd." FontSize="13" TextColor="#3A4A40"
                   VerticalOptions="Center" />
            <Button Grid.Column="1" Text="Controleer nu" FontSize="12" Padding="10,6" Clicked="OnCheckNowClicked" />
        </Grid>

        <RefreshView Grid.Row="1" x:Name="RefreshViewControl" Refreshing="OnRefreshing">
            <CollectionView x:Name="SearchesCollectionView">
                <CollectionView.EmptyView>
                    <VerticalStackLayout Padding="24" Spacing="8" VerticalOptions="Center">
                        <Label Text="Nog geen zoekopdrachten" FontSize="18" HorizontalOptions="Center" />
                        <Label Text="Tik rechtsboven op '+ Nieuw' om Marktplaats te laten uitkijken naar bepaalde steekwoorden."
                               HorizontalTextAlignment="Center" TextColor="Gray" />
                    </VerticalStackLayout>
                </CollectionView.EmptyView>
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:SavedSearch">
                        <SwipeView>
                            <SwipeView.RightItems>
                                <SwipeItems>
                                    <SwipeItem Text="Verwijder" BackgroundColor="{StaticResource Danger}"
                                               Invoked="OnDeleteSwiped" />
                                </SwipeItems>
                            </SwipeView.RightItems>
                            <Grid Padding="16,12" ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">
                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnItemTapped" />
                                </Grid.GestureRecognizers>
                                <Label Grid.Row="0" Grid.Column="0" Text="{Binding Name}" FontSize="16" FontAttributes="Bold" />
                                <Label Grid.Row="1" Grid.Column="0" Text="{Binding Keywords}" TextColor="Gray" FontSize="13" />
                                <Switch Grid.Row="0" Grid.RowSpan="2" Grid.Column="1" IsToggled="{Binding Enabled}"
                                        Toggled="OnEnabledToggled" />
                            </Grid>
                        </SwipeView>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </RefreshView>
    </Grid>
</ContentPage>
